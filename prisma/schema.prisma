generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  STUDENT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  VIOLATED
}

enum ContentType {
  VIDEO
  TEXT
  PDF
}

enum TestPurpose {
  GENERAL
  MODULE
  FINAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(STUDENT)
  collegeId     String?
  departmentId  String?
  year          Int?      // studying year e.g. 1,2,3,4
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  college       College?  @relation(fields: [collegeId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])

  createdCourses     Course[]       @relation("CourseCreator")
  createdQuestions   Question[]     @relation("QuestionCreator")
  createdQuestionBanks QuestionBank[] @relation("QuestionBankCreator")
  createdTests       Test[]         @relation("TestCreator")
  attempts           TestAttempt[]
  certificates       Certificate[]
  enrollments        Enrollment[]
  moduleProgress     ModuleProgress[]

  @@index([collegeId])
  @@index([role])
}

model College {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  courses     Course[]
  questions   Question[]
  questionBanks QuestionBank[]
  tests       Test[]
  certificates Certificate[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  collegeId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users       User[]
  courses     Course[]
  questions   Question[]
  tests       Test[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  code        String?
  collegeId   String?
  departmentId String?
  createdById String
  isActive    Boolean  @default(true)
  passingScore Int     @default(40)
  finalTestId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College?    @relation(fields: [collegeId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  createdBy   User        @relation("CourseCreator", fields: [createdById], references: [id])
  finalTest   Test?       @relation("CourseFinalTest", fields: [finalTestId], references: [id])
  tests       Test[]      @relation("CourseTests")
  modules     CourseModule[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@index([collegeId])
  @@index([departmentId])
}

model CourseModule {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  description      String?
  order            Int      @default(0)
  assessmentTestId String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentTest   Test?    @relation("ModuleAssessment", fields: [assessmentTestId], references: [id])
  contents         ModuleContent[]
  progress         ModuleProgress[]

  @@index([courseId])
}

model ModuleContent {
  id          String      @id @default(cuid())
  moduleId    String
  title       String
  type        ContentType @default(TEXT)
  body        String?
  url         String?
  order       Int         @default(0)
  durationMin Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model ModuleProgress {
  id               String    @id @default(cuid())
  studentId        String
  moduleId         String
  contentsDone     String?
  assessmentPassed Boolean   @default(false)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module           CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

model QuestionBank {
  id          String   @id @default(cuid())
  name        String
  description String?
  collegeId   String?  // null = global / reusable across colleges
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College?  @relation(fields: [collegeId], references: [id])
  createdBy   User      @relation("QuestionBankCreator", fields: [createdById], references: [id])
  questions   Question[]

  @@index([collegeId])
}

model Question {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MCQ)
  options       String?      // JSON string for MCQ options
  correctAnswer String
  explanation   String?
  difficulty    Int          @default(1) // 1-5
  marks         Int          @default(1)
  collegeId     String?
  departmentId  String?
  questionBankId String?
  createdById   String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  college       College?     @relation(fields: [collegeId], references: [id])
  department    Department?  @relation(fields: [departmentId], references: [id])
  questionBank  QuestionBank? @relation(fields: [questionBankId], references: [id])
  createdBy     User         @relation("QuestionCreator", fields: [createdById], references: [id])
  testQuestions TestQuestion[]
  answers       Answer[]

  @@index([collegeId])
  @@index([departmentId])
  @@index([questionBankId])
}

model Test {
  id              String     @id @default(cuid())
  title           String
  description     String?
  courseId        String?
  collegeId       String
  departmentId    String?
  durationMinutes Int        @default(60)
  totalMarks      Int        @default(100)
  passingMarks    Int        @default(40)
  isProctored     Boolean    @default(true)
  status          TestStatus @default(DRAFT)
  purpose         TestPurpose @default(GENERAL)
  startTime       DateTime?
  endTime         DateTime?
  maxAttempts     Int        @default(1)
  shuffleQuestions Boolean   @default(true)
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  course          Course?    @relation("CourseTests", fields: [courseId], references: [id])
  finalForCourse  Course?    @relation("CourseFinalTest")
  moduleAssessment CourseModule? @relation("ModuleAssessment")
  college         College    @relation(fields: [collegeId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  createdBy       User       @relation("TestCreator", fields: [createdById], references: [id])
  questions       TestQuestion[]
  attempts        TestAttempt[]

  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  marks      Int    @default(1)
  order      Int    @default(0)

  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
}

model TestAttempt {
  id            String        @id @default(cuid())
  testId        String
  studentId     String
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  score         Float?
  percentage    Float?
  status        AttemptStatus @default(IN_PROGRESS)
  violations    String?       // JSON array of violation events
  timeSpentSec  Int?
  ipAddress     String?
  userAgent     String?
  feedback      String?

  test          Test          @relation(fields: [testId], references: [id])
  student       User          @relation(fields: [studentId], references: [id])
  answers       Answer[]

  @@index([testId])
  @@index([studentId])
  @@unique([testId, studentId, startedAt]) // allow multiple attempts if configured
}

model Answer {
  id            String  @id @default(cuid())
  attemptId     String
  questionId    String
  answer        String?
  isCorrect     Boolean?
  marksAwarded  Float   @default(0)

  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime @default(now())
  progress    Float    @default(0) // 0-100
  completedAt DateTime?

  student     User     @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Certificate {
  id                String   @id @default(cuid())
  studentId         String
  courseId          String
  collegeId         String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  pdfPath           String?
  score             Float?

  student           User     @relation(fields: [studentId], references: [id])
  course            Course   @relation(fields: [courseId], references: [id])
  college           College  @relation(fields: [collegeId], references: [id])

  @@index([studentId])
  @@index([courseId])
}
