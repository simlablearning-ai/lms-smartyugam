generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  STUDENT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  VIOLATED
}

enum ContentType {
  VIDEO
  TEXT
  PDF
}

enum TestPurpose {
  GENERAL
  MODULE
  FINAL
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  BLOCKED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum TechLanguage {
  PYTHON
  JAVA
  JAVASCRIPT
  CPP
  C
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  password      String
  name          String
  role          Role      @default(STUDENT)
  rollNumber    String?   @unique
  collegeId     String?
  departmentId  String?
  year          Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  college       College?  @relation(fields: [collegeId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])

  createdCourses     Course[]       @relation("CourseCreator")
  createdQuestions   Question[]     @relation("QuestionCreator")
  createdQuestionBanks QuestionBank[] @relation("QuestionBankCreator")
  createdTests       Test[]         @relation("TestCreator")
  attempts           TestAttempt[]
  certificates       Certificate[]
  enrollments        Enrollment[]
  moduleProgress     ModuleProgress[]
  placementProfile   PlacementProfile?
  jobApplications    JobApplication[]
  placementBlocks    PlacementBlock[]  @relation("BlockedStudent")
  blocksCreated      PlacementBlock[]  @relation("BlockCreator")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  passwordResets     PasswordResetToken[]

  createdTechProblems TechProblem[]  @relation("TechProblemCreator")
  createdTechTests    TechTest[]     @relation("TechTestCreator")
  techAttempts        TechAttempt[]

  @@index([collegeId])
  @@index([role])
  @@index([rollNumber])
}

model College {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  courses     Course[]
  questions   Question[]
  questionBanks QuestionBank[]
  tests       Test[]
  certificates Certificate[]
  jobPostings  JobPosting[]

  techProblems TechProblem[]
  techTests    TechTest[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  collegeId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users       User[]
  courses     Course[]
  questions   Question[]
  tests       Test[]

  techTests   TechTest[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  code        String?
  collegeId   String?
  departmentId String?
  createdById String
  isActive    Boolean  @default(true)
  passingScore Int     @default(40)
  finalTestId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College?    @relation(fields: [collegeId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  createdBy   User        @relation("CourseCreator", fields: [createdById], references: [id])
  finalTest   Test?       @relation("CourseFinalTest", fields: [finalTestId], references: [id])
  tests       Test[]      @relation("CourseTests")
  modules     CourseModule[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@index([collegeId])
  @@index([departmentId])
}

model CourseModule {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  description      String?
  order            Int      @default(0)
  assessmentTestId String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentTest   Test?    @relation("ModuleAssessment", fields: [assessmentTestId], references: [id])
  contents         ModuleContent[]
  progress         ModuleProgress[]

  @@index([courseId])
}

model ModuleContent {
  id          String      @id @default(cuid())
  moduleId    String
  title       String
  type        ContentType @default(TEXT)
  body        String?
  url         String?
  order       Int         @default(0)
  durationMin Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model ModuleProgress {
  id               String    @id @default(cuid())
  studentId        String
  moduleId         String
  contentsDone     String?
  assessmentPassed Boolean   @default(false)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module           CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

model QuestionBank {
  id          String   @id @default(cuid())
  name        String
  description String?
  collegeId   String?
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College?  @relation(fields: [collegeId], references: [id])
  createdBy   User      @relation("QuestionBankCreator", fields: [createdById], references: [id])
  questions   Question[]

  @@index([collegeId])
}

model Question {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MCQ)
  options       String?
  correctAnswer String
  explanation   String?
  difficulty    Int          @default(1)
  marks         Int          @default(1)
  imageUrl      String?
  optionImages  String?
  collegeId     String?
  departmentId  String?
  questionBankId String?
  createdById   String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  college       College?     @relation(fields: [collegeId], references: [id])
  department    Department?  @relation(fields: [departmentId], references: [id])
  questionBank  QuestionBank? @relation(fields: [questionBankId], references: [id])
  createdBy     User         @relation("QuestionCreator", fields: [createdById], references: [id])
  testQuestions TestQuestion[]
  answers       Answer[]

  @@index([collegeId])
  @@index([departmentId])
  @@index([questionBankId])
}

model Test {
  id              String     @id @default(cuid())
  title           String
  description     String?
  courseId        String?
  collegeId       String
  departmentId    String?
  durationMinutes Int        @default(60)
  totalMarks      Int        @default(100)
  passingMarks    Int        @default(40)
  isProctored     Boolean    @default(true)
  status          TestStatus @default(DRAFT)
  purpose         TestPurpose @default(GENERAL)
  startTime       DateTime?
  endTime         DateTime?
  maxAttempts     Int        @default(1)
  shuffleQuestions Boolean   @default(true)
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  course          Course?    @relation("CourseTests", fields: [courseId], references: [id])
  finalForCourse  Course?    @relation("CourseFinalTest")
  moduleAssessment CourseModule? @relation("ModuleAssessment")
  college         College    @relation(fields: [collegeId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  createdBy       User       @relation("TestCreator", fields: [createdById], references: [id])
  questions       TestQuestion[]
  attempts        TestAttempt[]

  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  marks      Int    @default(1)
  order      Int    @default(0)

  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
}

model TestAttempt {
  id            String        @id @default(cuid())
  testId        String
  studentId     String
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  score         Float?
  percentage    Float?
  status        AttemptStatus @default(IN_PROGRESS)
  violations    String?
  timeSpentSec  Int?
  ipAddress     String?
  userAgent     String?
  feedback      String?

  test          Test          @relation(fields: [testId], references: [id])
  student       User          @relation(fields: [studentId], references: [id])
  answers       Answer[]

  @@index([testId])
  @@index([studentId])
  @@unique([testId, studentId, startedAt])
}

model Answer {
  id            String  @id @default(cuid())
  attemptId     String
  questionId    String
  answer        String?
  isCorrect     Boolean?
  marksAwarded  Float   @default(0)

  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime @default(now())
  progress    Float    @default(0)
  completedAt DateTime?

  student     User     @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Certificate {
  id                String   @id @default(cuid())
  studentId         String
  courseId          String
  collegeId         String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  pdfPath           String?
  score             Float?

  student           User     @relation(fields: [studentId], references: [id])
  course            Course   @relation(fields: [courseId], references: [id])
  college           College  @relation(fields: [collegeId], references: [id])

  @@index([studentId])
  @@index([courseId])
}

model PlacementProfile {
  id            String   @id @default(cuid())
  studentId     String   @unique
  headline      String?
  summary       String?
  phone         String?
  location      String?
  linkedinUrl   String?
  githubUrl     String?
  portfolioUrl  String?
  resumeUrl     String?
  skills        String?
  education     String?
  experience    String?
  cgpa          Float?
  backlogs      Int      @default(0)
  isComplete    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id              String    @id @default(cuid())
  title           String
  companyName     String
  location        String?
  jobType         String?
  description     String?
  requirements    String?
  skillsRequired  String?
  packageLpa      Float?
  minCgpa         Float?
  maxBacklogs     Int?
  eligibleYears   String?
  eligibleDepts   String?
  collegeId       String?
  status          JobStatus @default(OPEN)
  applicationDeadline DateTime?
  interviewNotes  String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college         College?  @relation(fields: [collegeId], references: [id])
  applications    JobApplication[]
  blocks          PlacementBlock[]

  @@index([status])
  @@index([collegeId])
}

model JobApplication {
  id            String            @id @default(cuid())
  jobId         String
  studentId     String
  status        ApplicationStatus @default(APPLIED)
  score         Float?
  adminNotes    String?
  interviewRound String?
  interviewAt   DateTime?
  interviewInfo String?
  appSkills     String?
  appResume     String?
  appHeadline   String?
  coverLetter   String?
  resumeFileName String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job           JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([jobId])
  @@index([studentId])
  @@index([status])
}

model PlacementBlock {
  id          String   @id @default(cuid())
  jobId       String
  studentId   String
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student     User       @relation("BlockedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("BlockCreator", fields: [createdById], references: [id])

  @@unique([jobId, studentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  link      String?
  read      Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// TechAbility — coding tests (separate from MCQ)
// ─────────────────────────────────────────────

model TechProblem {
  id           String       @id @default(cuid())
  title        String
  description  String
  language     TechLanguage @default(PYTHON)
  starterCode  String?
  solutionCode String?
  /// JSON: [{ input, expectedOutput, isHidden? }]
  testCases    String       @default("[]")
  marks        Int          @default(10)
  difficulty   Int          @default(1)
  collegeId    String?
  createdById  String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  college      College?     @relation(fields: [collegeId], references: [id])
  createdBy    User         @relation("TechProblemCreator", fields: [createdById], references: [id])
  testProblems TechTestProblem[]
  submissions  TechSubmission[]

  @@index([collegeId])
  @@index([language])
}

model TechTest {
  id              String     @id @default(cuid())
  title           String
  description     String?
  collegeId       String
  departmentId    String?
  durationMinutes Int        @default(60)
  totalMarks      Int        @default(100)
  passingMarks    Int        @default(40)
  isProctored     Boolean    @default(true)
  status          TestStatus @default(DRAFT)
  startTime       DateTime?
  endTime         DateTime?
  maxAttempts     Int        @default(1)
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  college         College    @relation(fields: [collegeId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  createdBy       User       @relation("TechTestCreator", fields: [createdById], references: [id])
  problems        TechTestProblem[]
  attempts        TechAttempt[]

  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model TechTestProblem {
  id        String @id @default(cuid())
  testId    String
  problemId String
  marks     Int    @default(10)
  order     Int    @default(0)

  test      TechTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  problem   TechProblem @relation(fields: [problemId], references: [id])

  @@unique([testId, problemId])
}

model TechAttempt {
  id           String        @id @default(cuid())
  testId       String
  studentId    String
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  score        Float?
  percentage   Float?
  status       AttemptStatus @default(IN_PROGRESS)
  violations   String?
  timeSpentSec Int?

  test         TechTest      @relation(fields: [testId], references: [id])
  student      User          @relation(fields: [studentId], references: [id])
  submissions  TechSubmission[]

  @@index([testId])
  @@index([studentId])
}

model TechSubmission {
  id          String       @id @default(cuid())
  attemptId   String
  problemId   String
  code        String
  language    TechLanguage
  score       Float        @default(0)
  maxScore    Float        @default(0)
  results     String?
  submittedAt DateTime     @default(now())

  attempt     TechAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem     TechProblem  @relation(fields: [problemId], references: [id])

  @@unique([attemptId, problemId])
}
