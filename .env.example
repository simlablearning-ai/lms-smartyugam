# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://username:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"


# Email (Resend) — optional; without it, emails are skipped
RESEND_API_KEY=
EMAIL_FROM="SmartYugam LMS <onboarding@resend.dev>"

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartyugam.com
